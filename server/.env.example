NODE_ENV=development
# Add this to server/.env (copy from .env.example and fill in your values)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
PORT=3001

# SECURITY: Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.railway.app

# ENVIRONMENT
NODE_ENV=production
